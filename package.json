{
  "name": "terrific-ocr",
  "version": "0.0.1",
  "description": "TerrificOCR - Desktop OCR application for PDF processing",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build",
    "build:win": "npm run build && electron-builder --win --config.win.signingHashAlgorithms=[]",
    "build:standalone": "powershell -ExecutionPolicy Bypass -File scripts/build-simple.ps1",
    "setup:bundled": "powershell -ExecutionPolicy Bypass -File scripts/setup-bundled.ps1",
    "copy:tesseract": "powershell -ExecutionPolicy Bypass -File scripts/copy-tesseract.ps1",
    "package": "npm run build && electron-builder",
    "version:patch": "npm version patch && npm run build:standalone",
    "version:minor": "npm version minor && npm run build:standalone",
    "version:major": "npm version major && npm run build:standalone"
  },
  "keywords": ["ocr", "pdf", "tesseract", "electron", "terrific"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.terrificocr.app",
    "productName": "TerrificOCR",
    "directories": {
      "output": "dist-v1"
    },
    "files": [
      "electron/**/*",
      "build/**/*",
      "python/**/*",
      "!python/__pycache__",
      "!python/*.pyc",
      "!python/test_ocr.py"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": ["**/*", "!__pycache__", "!*.pyc", "!test_ocr.py"]
      },
      {
        "from": "bundled/python-embed",
        "to": "python-embed",
        "filter": ["**/*"]
      },
      {
        "from": "bundled/tesseract",
        "to": "tesseract",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "signingHashAlgorithms": null,
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TerrificOCR"
    }
  }
}
